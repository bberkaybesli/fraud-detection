# Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ============================================
# NEO4J CONFIGURATION
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION
# ============================================
# IMPORTANT: Change these in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# MASAK MOCK SERVICE
# ============================================
MASAK_MOCK_URL=http://localhost:4000

# ============================================
# FRAUD DETECTION THRESHOLDS
# ============================================
# Fraud score threshold for rejection (0-100)
FRAUD_SCORE_REJECT_THRESHOLD=70
# Fraud score threshold for manual review (0-100)
FRAUD_SCORE_REVIEW_THRESHOLD=30

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_TRANSACTIONS=10

# Cycle detection
CYCLE_MIN_LENGTH=3
CYCLE_MAX_LENGTH=6
CYCLE_MIN_AMOUNT=1000
CYCLE_TIME_WINDOW_HOURS=24

# Smurfing detection
SMURFING_MIN_TX_COUNT=20
SMURFING_MIN_TOTAL_AMOUNT=500000
SMURFING_TIME_WINDOW_HOURS=24

# Amount anomaly detection
AMOUNT_ANOMALY_MULTIPLIER=10

# PageRank threshold (percentile)
PAGERANK_HIGH_RISK_PERCENTILE=95

# ============================================
# PERFORMANCE
# ============================================
# Neo4j connection pool
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30000

# Redis connection
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# ============================================
# SECURITY
# ============================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API rate limiting (requests per minute)
API_RATE_LIMIT=100

# ============================================
# MONITORING & LOGGING
# ============================================
# Enable audit logging for fraud decisions
ENABLE_AUDIT_LOG=true
AUDIT_LOG_PATH=./logs/audit.log

# Enable performance metrics
ENABLE_METRICS=true

# ============================================
# BATCH PROCESSING
# ============================================
# Cron schedule for PageRank (default: 3 AM daily)
PAGERANK_CRON_SCHEDULE=0 3 * * *

# Cron schedule for Louvain (default: 3:30 AM daily)
LOUVAIN_CRON_SCHEDULE=30 3 * * *

# ============================================
# DEVELOPMENT
# ============================================
# Enable debug mode
DEBUG=false

# Enable seed data on startup
AUTO_SEED=false
