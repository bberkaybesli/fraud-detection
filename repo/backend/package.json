{
    "name": "fraud-detection-backend",
    "version": "1.0.0",
    "description": "Financial Fraud Detection System - Backend API",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "test:integration": "jest --testPathPattern=tests/integration",
        "test:fraud-scenarios": "jest --testPathPattern=tests/fraud-scenarios",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "seed": "ts-node src/seed.ts",
        "init-neo": "cypher-shell -u neo4j -p password123 -f ../init-neo.cypher",
        "worker:masak": "ts-node src/workers/masak-worker.ts"
    },
    "keywords": [
        "fraud-detection",
        "neo4j",
        "redis",
        "graph-database",
        "financial-security"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "neo4j-driver": "^5.18.0",
        "redis": "^4.6.13",
        "jsonwebtoken": "^9.0.2",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.4.5",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "express-rate-limit": "^7.1.5",
        "winston": "^3.11.0",
        "joi": "^17.12.1",
        "uuid": "^9.0.1",
        "node-cron": "^3.0.3"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.16",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/uuid": "^9.0.8",
        "@types/node-cron": "^3.0.11",
        "@types/jest": "^29.5.12",
        "@typescript-eslint/eslint-plugin": "^6.20.0",
        "@typescript-eslint/parser": "^6.20.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3",
        "supertest": "^6.3.4",
        "@types/supertest": "^6.0.2"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}